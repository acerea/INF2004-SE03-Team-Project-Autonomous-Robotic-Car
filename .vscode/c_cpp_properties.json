{
  "configurations": [
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/include/**",
        "${workspaceFolder}/config/**",
        "${workspaceFolder}/kernel/**",
        "${workspaceFolder}/mtkernel_3/**"
